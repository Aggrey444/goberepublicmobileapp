# Normalize line endings for text files across platforms
* text=auto

# Diff semantics (Laravel)
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Exclude from archives
/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Source code
*.php text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.env.example text eol=lf
*.env text eol=lf
*.blade.php text eol=lf

# Binaries / images (never convert)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
